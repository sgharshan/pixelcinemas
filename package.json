{
  "name": "pixel-cinemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c yellow,cyan \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "seed": "node scripts/seed.js",
    "test:e2e": "npm run test:e2e --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22"
  }
}
